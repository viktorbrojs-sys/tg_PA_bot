# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env

# ── Обязательно ──────────────────────────────────────────────────────────────
# Токен бота от @BotFather в Telegram
TG_BOT_TOKEN=123456789:ABCdefGHIJKLMNOPQRSTUVWXYZ

# ── Опционально ──────────────────────────────────────────────────────────────
# Полный путь к markdown-файлу задач в Obsidian-хранилище.
# Поддерживается ~ для домашней директории.
# По умолчанию: ~/ObsidianVault/Задачи.md
#
# Примеры:
#   OBSIDIAN_FILE=~/ObsidianVault/Задачи.md
#   OBSIDIAN_FILE=/home/user/Documents/Vault/Inbox.md
#   OBSIDIAN_FILE=C:\Users\User\ObsidianVault\Задачи.md
OBSIDIAN_FILE=~/ObsidianVault/Задачи.md

# Whitelist Telegram user_id через запятую.
# Пусто или не задано — бот отвечает всем.
# Как узнать свой ID: напишите @userinfobot в Telegram.
#ALLOWED_USER_IDS=123456789

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO

# ── ИИ-классификация задач (опционально) ──────────────────────────────────────
# Без ключа бот работает как раньше, но без классификации: все новые задачи
# попадают в раздел "Входящие", а /plan просто делит текст по строкам.
# Ключ DeepSeek: https://platform.deepseek.com/api_keys
#DEEPSEEK_API_KEY=sk-...
#LLM_MODEL=deepseek-chat

# Разделы, по которым ИИ раскладывает задачи (через запятую).
# По умолчанию: Работа,Личное
#TASK_SECTIONS=Работа,Личное

# ── Проактивный секретарь (утренний дайджест, вечерняя рефлексия) ─────────────
# Chat ID, куда бот будет сам писать по расписанию. Если не задан, но в
# ALLOWED_USER_IDS указан ровно один ID — используется он (в личном чате
# Telegram chat_id == user_id).
#TELEGRAM_CHAT_ID=123456789

# Часовой пояс для расписания (IANA-имя, напр. Europe/Moscow, Asia/Tomsk).
#TIMEZONE=Europe/Moscow

# Время утреннего дайджеста и вечерней рефлексии, формат ЧЧ:ММ (24ч).
#MORNING_DIGEST_TIME=08:00
#EVENING_REFLECTION_TIME=21:00

# День и время еженедельного обзора выполненных задач.
# День — mon/tue/wed/thu/fri/sat/sun.
#WEEKLY_REVIEW_DAY=sun
#WEEKLY_REVIEW_TIME=20:00

# ── Google Calendar (read-only, опционально) ──────────────────────────────────
# Встречи в утреннем дайджесте + подготовка к встрече за N минут до события.
# Как получить: создайте OAuth-клиент в Google Cloud Console (тип "TVs and
# Limited Input devices"), затем один раз запустите:
#   python scripts/google_calendar_auth.py
# Скрипт выведет готовые строки для этого блока. Подробнее — в USER_GUIDE.md.
#GOOGLE_CALENDAR_CLIENT_ID=
#GOOGLE_CALENDAR_CLIENT_SECRET=
#GOOGLE_CALENDAR_REFRESH_TOKEN=
#GOOGLE_CALENDAR_ID=primary

# За сколько минут до встречи присылать подготовку (context brief).
#MEETING_BRIEF_LEAD_MINUTES=30

# ── Погода (опционально, бесплатно, без ключа — Open-Meteo) ───────────────────
# Погода на сегодня в утреннем дайджесте + подсказка взять зонт при высокой
# вероятности осадков. Нужны только координаты (широта/долгота), например
# для Москвы: 55.75 / 37.62. Найти свои можно на google maps: правый клик по
# точке на карте покажет координаты.
#WEATHER_LATITUDE=
#WEATHER_LONGITUDE=
